# =============================================================================
# API (apps/api) — Variables de entorno
# Copiar a apps/api/.env y reemplazar los valores
# =============================================================================

# --- Servidor ---
PORT=3001

# --- Base de datos PostgreSQL ---
# Ejemplo local: postgresql://root:rootpassword@localhost:5432/hipotecario_db?schema=public
# Ejemplo Cloud SQL: postgresql://user:pass@/hipotecario_db?host=/cloudsql/INSTANCE_CONNECTION_NAME
DATABASE_URL=postgresql://root:rootpassword@localhost:5432/hipotecario_db?schema=public

# --- JWT ---
JWT_SECRET=cambiar-por-secreto-seguro
JWT_EXPIRES_IN=8h

# --- Configuración de Correo (Gmail SMTP) ---
# Para Gmail, usa una contraseña de aplicación (App Password) generada en tu cuenta de Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
MAIL_FROM="Gestión Financiera <no-reply@gestionfinanciera.com>"
APP_URL=http://localhost:3000

# --- Google Cloud Storage (PDFs de clientes) ---
# Nombre del bucket donde se guardan los documentos subidos
GCS_BUCKET_NAME=hipotecario-documentos-dev
# ID del proyecto de Google Cloud
GCS_PROJECT_ID=gestion-financiera-499302
# Tamaño máximo de subida en megabytes
MAX_UPLOAD_SIZE_MB=10
# Ruta al archivo JSON de credenciales de la cuenta de servicio
# En Cloud Run o GCE, dejar vacío para usar Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# --- Google Cloud Document AI (OCR de PDFs) ---
# ID del proyecto de Google Cloud
GCLOUD_PROJECT_ID=gestion-financiera-499302
# Ubicación del procesador Document AI ("us" o "eu")
GCLOUD_LOCATION=us
# ID del procesador Document AI (crear uno en GCP Console > Document AI)
GCLOUD_PROCESSOR_ID=3856012ede9fdbfd

# --- Gemini (Vertex AI) — Extracción de datos con IA ---
# ID del proyecto de Google Cloud
GEMINI_PROJECT_ID=gestion-financiera-499302
# Ubicación de Vertex AI (us-central1 recomendado)
GEMINI_LOCATION=us-central1
# Modelo de Gemini a usar
GEMINI_MODEL=gemini-2.5-flash
# Timeout en milisegundos para cada llamada a Gemini
GEMINI_TIMEOUT_MS=300000
# Tokens máximos de salida (global). Buró puede necesitar valores altos.
# La extracción cover-only de estados de cuenta sobrescribe a 4096 en código.
GEMINI_MAX_OUTPUT_TOKENS=65536

# --- Extracción por coordenadas (buró de crédito) ---
# Determina paymentDueAmount desde la posición de columnas en el PDF
# true = activado (recomendado). false = solo Gemini
COORDINATE_EXTRACTION_ENABLED=true

# --- Extracción por layout (feature flag experimental) ---
# Usa el layout de Document AI para extraer campos financieros
# Recomendado: false (la extracción por coordenadas es más precisa)
USE_LAYOUT_EXTRACTION=false


# =============================================================================
# Frontend (apps/web) — Variables de entorno
# Copiar a apps/web/.env.local
# =============================================================================

# URL de la API (en desarrollo: http://localhost:3001)
API_URL=http://localhost:3001
